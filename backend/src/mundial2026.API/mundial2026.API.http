@mundial2026.API_HostAddress = http://localhost:5053

### Auth - Login admin seed
POST {{mundial2026.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin.usa@mundial.com",
  "password": "Password123!"
}

### Auth - Registro usuario
POST {{mundial2026.API_HostAddress}}/api/auth/registro
Content-Type: application/json

{
  "rol": "Usuario",
  "email": "nuevo.usuario@gmail.com",
  "password": "Password123!",
  "paisDir": "Uruguay",
  "localidad": "Montevideo",
  "calle": "Ejido",
  "numeroDir": "123",
  "codPostal": "11000",
  "docPais": "Uruguay",
  "docTipo": "CI",
  "docNumero": "UY999999",
  "telefonos": ["+598 99 000 000"]
}

